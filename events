            color: #000000;
        }

        .navbar {
            width: 100%;
            padding: 15px 25px;
            display: flex;
            align-items: center;
            background: #ffffffcc;
            backdrop-filter: blur(6px);
            position: fixed;
            top: 0;
            z-index: 100;
        }

        .navbar-title {
            font-size: 22px;
            font-weight: bold;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 120px auto 60px auto;
        }

        h1 {
            font-size: 28px;
            margin-bottom: 20px;
        }

        .timeline {
            border-left: 4px solid #000;
            padding-left: 20px;
            margin-top: 30px;
        }

        .event {
            margin-bottom: 30px;
        }

        .event h3 {
            margin: 0;
            font-size: 20px;
        }

        .event p {
            margin: 6px 0;
            font-size: 14px;
